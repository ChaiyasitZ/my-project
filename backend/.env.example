# ── MongoDB Configuration ──
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/network_automation?retryWrites=true&w=majority

# ── Server Configuration ──
PORT=3001
NODE_ENV=production

# ── Frontend URL (your Vercel deployment URL) ──
FRONTEND_URL=https://your-app.vercel.app

# ── Additional CORS Origins (comma-separated, optional) ──
# ADDITIONAL_ORIGINS=https://custom-domain.com

# ── Authentication ──
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-app.vercel.app/api/auth/google/callback
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-session-secret-change-in-production

# ── LLM Configuration ──
# Provider: 'ollama' (local via agent) or 'openrouter' (cloud API)
LLM_PROVIDER=ollama

# Ollama settings (when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2

# OpenRouter settings (when LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
