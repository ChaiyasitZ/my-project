{
  "name": "network-automation-backend",
  "version": "1.0.0",
  "description": "Simple Backend for Raw LLM-powered network automation",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --forceExit",
    "init-db": "node scripts/initMongoDB.js",
    "init-yang": "node scripts/initYangModels.js",
    "migrate-netconf": "node scripts/migrateNetconfDevices.js",
    "vercel-build": "echo 'Backend build complete'"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "fast-xml-parser": "^5.2.5",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.1",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",

    "xml-js": "^1.6.11",
    "xml2js": "^0.6.2",
    "xpath": "^0.0.32"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0",
    "@serialport/parser-readline": "^13.0.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  },
  "keywords": [
    "network",
    "automation",
    "cisco",
    "ai",
    "ssh",
    "mongodb",
    "netconf",
    "yang"
  ],
  "author": "Network Automation Team",
  "license": "MIT"
}
