{
  "name": "network-automation-backend",
  "version": "2.0.0",
  "description": "Backend for AI-powered network automation with MongoDB and NETCONF",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/initMongoDB.js",
    "init-yang": "node scripts/initYangModels.js",
    "init-mock": "node scripts/initMockDevices.js",
    "setup-demo": "npm run init-yang && npm run init-mock"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "netconf": "^1.2.0",
    "ollama": "^0.5.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.15.0",
    "xml2js": "^0.6.2",
    "xpath": "^0.0.32"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "network",
    "automation",
    "cisco",
    "ai",
    "ssh",
    "mongodb",
