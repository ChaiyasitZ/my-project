{
  "name": "netconfig-agent-gui",
  "version": "1.2.0",
  "description": "NetConfig Agent - GUI desktop app for managing network devices",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.netconfig.agent",
    "productName": "NetConfig Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/serialport/**",
      "node_modules/@serialport/**",
      "node_modules/ssh2/**",
      "node_modules/cpu-features/**"
    ],
    "win": {
      "target": "dir",
      "sign": false,
      "signingHashAlgorithms": null,
      "signDlls": false
    },
    "portable": {
      "artifactName": "NetConfigAgent-${os}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
